{
  "name": "@serveflow/config",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tsconfig": {
      "types": "./tsconfig.base.json",
      "default": "./tsconfig.base.json"
    },
    "./tailwind": {
      "types": "./tailwind.config.ts",
      "default": "./tailwind.config.ts"
    }
  },
  "files": [
    "tsconfig.base.json",
    "tailwind.config.ts",
    "eslint.config.mjs"
  ],
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "tailwindcss": "^3.4.17"
  }
}
