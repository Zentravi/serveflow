# ServeFlow Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://serveflow:serveflow@localhost:5432/serveflow?schema=public"
POSTGRES_USER=serveflow
POSTGRES_PASSWORD=serveflow
POSTGRES_DB=serveflow
POSTGRES_PORT=5432

# Session
SESSION_SECRET=change-me-in-production-min-32-chars
SESSION_MAX_AGE=1209600000

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (notifications — synchronous at MVP)
# Required for sending booking confirmations and reminders.
# Leave unset to gracefully skip notification sending at MVP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Super-admin registration code (one-time setup)
SUPER_ADMIN_REGISTRATION_CODE=
